# SerpApi Google Flights search key
SERPAPI_API_KEY=

# Create a Telegram bot with @BotFather, then set its token and your chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Search settings
ORIGIN_AIRPORTS=GRU,CGH
DESTINATION_AIRPORT=CNF
DEPARTURE_DATE=2026-12-17
RETURN_DATE=2026-12-20
DATE_WINDOW_DAYS=0
POLL_INTERVAL_MINUTES=360
MAX_PRICE_BRL=500
ADULTS=1
CURRENCY=BRL
